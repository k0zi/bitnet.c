// Buffer-to-buffer copy
// p0 = src_offset, p1 = dst_offset, p2 = count (floats)
// Dispatch: (ceil(count/256), 1, 1)
#version 450

layout(local_size_x = 256) in;

layout(std430, set=0, binding=0) readonly buffer Src { float src[]; };
layout(std430, set=0, binding=1)          buffer Dst { float dst[]; };

layout(push_constant) uniform PC { uint p0, p1, p2, p3, p4, p5, p6, p7; };

void main() {
    uint i = gl_WorkGroupID.x * 256u + gl_LocalInvocationID.x;
    if (i < p2) dst[p1 + i] = src[p0 + i];
}
