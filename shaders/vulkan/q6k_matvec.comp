// Q6_K TILED matvec
// Dispatch: (ceil(rows/32), n_tokens, 1)
#version 450

layout(local_size_x = 256) in;

layout(std430, set=0, binding=0) readonly buffer Weights { uint weights[]; };
layout(std430, set=0, binding=1) readonly buffer X       { float x[]; };
layout(std430, set=0, binding=2)          buffer Out     { float out_buf[]; };

layout(push_constant) uniform PC {
    uint rows; uint cols; uint n_tokens; uint extra;
    uint out_offset; uint _p5; uint _p6; uint _p7;
};

shared float reduce_buf[256];

const uint TILE_ROWS = 32u;
const uint THREADS_PER_ROW = 8u;
const uint ELEMS_PER_THREAD = 32u;
const uint QK_K = 256u;
const uint BLOCK_BYTES = 210u;

float fp16_to_f32(uint bits){
    uint sign=(bits>>15u)&1u;uint e=(bits>>10u)&0x1Fu;uint mant=bits&0x3FFu;
    if(e==0u){if(mant==0u)return(sign==1u)?-0.0:0.0;float v=float(mant)*5.9604644775390625e-8;return(sign==1u)?-v:v;}
    return uintBitsToFloat((sign<<31u)|((e+112u)<<23u)|(mant<<13u));
}
uint read_u8(uint o){return(weights[o>>2u]>>((o&3u)*8u))&0xFFu;}
uint read_u16(uint o){return(weights[o>>2u]>>((o&2u)*8u))&0xFFFFu;}
int read_i8(uint o){uint v=read_u8(o);return(v>=128u)?(int(v)-256):int(v);}

float q6_value(uint ql,uint qh,uint qh_shift,bool ql_high){
    uint qlo=ql_high?(ql>>4u):(ql&0xFu);
    int q6=int(qlo|(((qh>>qh_shift)&3u)<<4u))-32;
    return float(q6);
}

void main(){
    uint tile_start=(extra>0u)?(gl_WorkGroupID.x+gl_WorkGroupID.y*extra)*TILE_ROWS:gl_WorkGroupID.x*TILE_ROWS;
    uint token=(extra>0u)?0u:gl_WorkGroupID.y;
    uint tid=gl_LocalInvocationID.x;
    uint local_row=tid/THREADS_PER_ROW; uint local_elem=tid%THREADS_PER_ROW;
    uint global_row=tile_start+local_row;
    uint n_blocks=cols/QK_K; uint x_base=token*cols;
    uint row_byte=global_row*n_blocks*BLOCK_BYTES;
    uint my_start=local_elem*ELEMS_PER_THREAD;
    uint half_idx=my_start/128u;
    uint quarter=(my_start%128u)/32u;
    uint ql_off=half_idx*64u; uint qh_off=half_idx*32u; uint sc_off=half_idx*8u;
    uint s_base=0u,qh_shift=0u,ql_add=0u; bool ql_high=false;
    if(quarter==0u){s_base=0u;qh_shift=0u;ql_add=0u;ql_high=false;}
    else if(quarter==1u){s_base=2u;qh_shift=2u;ql_add=32u;ql_high=false;}
    else if(quarter==2u){s_base=4u;qh_shift=4u;ql_add=0u;ql_high=true;}
    else{s_base=6u;qh_shift=6u;ql_add=32u;ql_high=true;}

    float acc=0.0;
    if(global_row<rows){
        for(uint bi=0u;bi<n_blocks;bi++){
            uint base=row_byte+bi*BLOCK_BYTES;
            float d=fp16_to_f32(read_u16(base+208u));
            uint ql_base=base; uint qh_base=base+128u; uint sc_base=base+192u;
            uint elem_base=bi*QK_K;
            uint qlp=ql_base+ql_off+ql_add; uint qhp=qh_base+qh_off; uint scp=sc_base+sc_off;
            float scale0=d*float(read_i8(scp+s_base));
            float scale1=d*float(read_i8(scp+s_base+1u));
            uint xb=x_base+elem_base+my_start;

            vec4 q0=vec4(q6_value(read_u8(qlp+0u),read_u8(qhp+0u),qh_shift,ql_high),q6_value(read_u8(qlp+1u),read_u8(qhp+1u),qh_shift,ql_high),q6_value(read_u8(qlp+2u),read_u8(qhp+2u),qh_shift,ql_high),q6_value(read_u8(qlp+3u),read_u8(qhp+3u),qh_shift,ql_high));
            vec4 q1=vec4(q6_value(read_u8(qlp+4u),read_u8(qhp+4u),qh_shift,ql_high),q6_value(read_u8(qlp+5u),read_u8(qhp+5u),qh_shift,ql_high),q6_value(read_u8(qlp+6u),read_u8(qhp+6u),qh_shift,ql_high),q6_value(read_u8(qlp+7u),read_u8(qhp+7u),qh_shift,ql_high));
            vec4 q2=vec4(q6_value(read_u8(qlp+8u),read_u8(qhp+8u),qh_shift,ql_high),q6_value(read_u8(qlp+9u),read_u8(qhp+9u),qh_shift,ql_high),q6_value(read_u8(qlp+10u),read_u8(qhp+10u),qh_shift,ql_high),q6_value(read_u8(qlp+11u),read_u8(qhp+11u),qh_shift,ql_high));
            vec4 q3=vec4(q6_value(read_u8(qlp+12u),read_u8(qhp+12u),qh_shift,ql_high),q6_value(read_u8(qlp+13u),read_u8(qhp+13u),qh_shift,ql_high),q6_value(read_u8(qlp+14u),read_u8(qhp+14u),qh_shift,ql_high),q6_value(read_u8(qlp+15u),read_u8(qhp+15u),qh_shift,ql_high));
            vec4 q4=vec4(q6_value(read_u8(qlp+16u),read_u8(qhp+16u),qh_shift,ql_high),q6_value(read_u8(qlp+17u),read_u8(qhp+17u),qh_shift,ql_high),q6_value(read_u8(qlp+18u),read_u8(qhp+18u),qh_shift,ql_high),q6_value(read_u8(qlp+19u),read_u8(qhp+19u),qh_shift,ql_high));
            vec4 q5=vec4(q6_value(read_u8(qlp+20u),read_u8(qhp+20u),qh_shift,ql_high),q6_value(read_u8(qlp+21u),read_u8(qhp+21u),qh_shift,ql_high),q6_value(read_u8(qlp+22u),read_u8(qhp+22u),qh_shift,ql_high),q6_value(read_u8(qlp+23u),read_u8(qhp+23u),qh_shift,ql_high));
            vec4 q6=vec4(q6_value(read_u8(qlp+24u),read_u8(qhp+24u),qh_shift,ql_high),q6_value(read_u8(qlp+25u),read_u8(qhp+25u),qh_shift,ql_high),q6_value(read_u8(qlp+26u),read_u8(qhp+26u),qh_shift,ql_high),q6_value(read_u8(qlp+27u),read_u8(qhp+27u),qh_shift,ql_high));
            vec4 q7=vec4(q6_value(read_u8(qlp+28u),read_u8(qhp+28u),qh_shift,ql_high),q6_value(read_u8(qlp+29u),read_u8(qhp+29u),qh_shift,ql_high),q6_value(read_u8(qlp+30u),read_u8(qhp+30u),qh_shift,ql_high),q6_value(read_u8(qlp+31u),read_u8(qhp+31u),qh_shift,ql_high));

            vec4 x0=vec4(x[xb+0u],x[xb+1u],x[xb+2u],x[xb+3u]);
            vec4 x1=vec4(x[xb+4u],x[xb+5u],x[xb+6u],x[xb+7u]);
            vec4 x2=vec4(x[xb+8u],x[xb+9u],x[xb+10u],x[xb+11u]);
            vec4 x3=vec4(x[xb+12u],x[xb+13u],x[xb+14u],x[xb+15u]);
            vec4 x4=vec4(x[xb+16u],x[xb+17u],x[xb+18u],x[xb+19u]);
            vec4 x5=vec4(x[xb+20u],x[xb+21u],x[xb+22u],x[xb+23u]);
            vec4 x6=vec4(x[xb+24u],x[xb+25u],x[xb+26u],x[xb+27u]);
            vec4 x7=vec4(x[xb+28u],x[xb+29u],x[xb+30u],x[xb+31u]);

            acc += scale0*(dot(q0,x0)+dot(q1,x1)+dot(q2,x2)+dot(q3,x3))
                 + scale1*(dot(q4,x4)+dot(q5,x5)+dot(q6,x6)+dot(q7,x7));
        }
    }

    reduce_buf[tid]=acc; barrier();
    uint row_base=local_row*THREADS_PER_ROW;
    if(local_elem<4u){reduce_buf[row_base+local_elem]+=reduce_buf[row_base+local_elem+4u];}barrier();
    if(local_elem<2u){reduce_buf[row_base+local_elem]+=reduce_buf[row_base+local_elem+2u];}barrier();
    if(local_elem<1u){reduce_buf[row_base+local_elem]+=reduce_buf[row_base+local_elem+1u];}barrier();
    if(local_elem==0u&&global_row<rows)
        out_buf[out_offset+token*rows+global_row]=reduce_buf[row_base];
}
