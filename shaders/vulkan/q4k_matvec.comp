// Q4_K TILED matvec
// Dispatch: (ceil(rows/32), n_tokens, 1)
#version 450

layout(local_size_x = 256) in;

layout(std430, set=0, binding=0) readonly buffer Weights { uint weights[]; };
layout(std430, set=0, binding=1) readonly buffer X       { float x[]; };
layout(std430, set=0, binding=2)          buffer Out     { float out_buf[]; };

layout(push_constant) uniform PC {
    uint rows; uint cols; uint n_tokens; uint extra;
    uint out_offset; uint _p5; uint _p6; uint _p7;
};

shared float reduce_buf[256];

const uint TILE_ROWS = 32u;
const uint THREADS_PER_ROW = 8u;
const uint ELEMS_PER_THREAD = 32u; // 256/8
const uint QK_K = 256u;
const uint BLOCK_BYTES = 144u;

float fp16_to_f32(uint bits) {
    uint sign = (bits >> 15u) & 1u;
    uint e = (bits >> 10u) & 0x1Fu;
    uint mant = bits & 0x3FFu;
    if (e == 0u) {
        if (mant == 0u) return (sign == 1u) ? -0.0 : 0.0;
        float val = float(mant) * 5.9604644775390625e-8;
        return (sign == 1u) ? -val : val;
    }
    uint f_bits = (sign << 31u) | ((e + 112u) << 23u) | (mant << 13u);
    return uintBitsToFloat(f_bits);
}

uint read_u8(uint offset) {
    return (weights[offset >> 2u] >> ((offset & 3u) * 8u)) & 0xFFu;
}

uint read_u16(uint offset) {
    return (weights[offset >> 2u] >> ((offset & 2u) * 8u)) & 0xFFFFu;
}

uvec2 get_scale_min(uint j, uint scales_base) {
    uint sc, m;
    if (j < 4u) {
        sc = read_u8(scales_base + j) & 63u;
        m  = read_u8(scales_base + j + 4u) & 63u;
    } else {
        sc = (read_u8(scales_base + j + 4u) & 0xFu) | ((read_u8(scales_base + j - 4u) >> 6u) << 4u);
        m  = (read_u8(scales_base + j + 4u) >> 4u)   | ((read_u8(scales_base + j) >> 6u) << 4u);
    }
    return uvec2(sc, m);
}

float q4_value(uint qbyte, bool is_high) {
    return is_high ? float(qbyte >> 4u) : float(qbyte & 0xFu);
}

uint byte_at(uint word, uint idx) { return (word >> (idx * 8u)) & 0xFFu; }

void main() {
    uint tile_start = (extra > 0u) ? (gl_WorkGroupID.x + gl_WorkGroupID.y * extra) * TILE_ROWS
                                   : gl_WorkGroupID.x * TILE_ROWS;
    uint token = (extra > 0u) ? 0u : gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;

    uint local_row = tid / THREADS_PER_ROW;
    uint local_elem = tid % THREADS_PER_ROW;
    uint global_row = tile_start + local_row;

    uint n_blocks = cols / QK_K;
    uint x_base = token * cols;
    uint row_byte = global_row * n_blocks * BLOCK_BYTES;

    float acc = 0.0;
    if (global_row < rows) {
        uint my_start = local_elem * ELEMS_PER_THREAD;
        uint group = my_start / 64u;
        uint is_high = (my_start % 64u) / 32u;
        uint sub = group * 2u + is_high;
        bool is_hi = (is_high != 0u);

        for (uint bi = 0u; bi < n_blocks; bi++) {
            uint base = row_byte + bi * BLOCK_BYTES;
            float d    = fp16_to_f32(read_u16(base));
            float dmin = fp16_to_f32(read_u16(base + 2u));
            uint scales_base = base + 4u;
            uint qs_base = base + 16u;
            uint elem_base = bi * QK_K;
            uvec2 sm = get_scale_min(sub, scales_base);
            uint q_off_base = qs_base + group * 32u;
            uint xb = x_base + elem_base + my_start;

            uint qw0=weights[(q_off_base+0u)>>2u]; uint qw1=weights[(q_off_base+4u)>>2u];
            uint qw2=weights[(q_off_base+8u)>>2u]; uint qw3=weights[(q_off_base+12u)>>2u];
            uint qw4=weights[(q_off_base+16u)>>2u]; uint qw5=weights[(q_off_base+20u)>>2u];
            uint qw6=weights[(q_off_base+24u)>>2u]; uint qw7=weights[(q_off_base+28u)>>2u];

            vec4 q0=vec4(q4_value(byte_at(qw0,0u),is_hi),q4_value(byte_at(qw0,1u),is_hi),q4_value(byte_at(qw0,2u),is_hi),q4_value(byte_at(qw0,3u),is_hi));
            vec4 q1=vec4(q4_value(byte_at(qw1,0u),is_hi),q4_value(byte_at(qw1,1u),is_hi),q4_value(byte_at(qw1,2u),is_hi),q4_value(byte_at(qw1,3u),is_hi));
            vec4 q2=vec4(q4_value(byte_at(qw2,0u),is_hi),q4_value(byte_at(qw2,1u),is_hi),q4_value(byte_at(qw2,2u),is_hi),q4_value(byte_at(qw2,3u),is_hi));
            vec4 q3=vec4(q4_value(byte_at(qw3,0u),is_hi),q4_value(byte_at(qw3,1u),is_hi),q4_value(byte_at(qw3,2u),is_hi),q4_value(byte_at(qw3,3u),is_hi));
            vec4 q4=vec4(q4_value(byte_at(qw4,0u),is_hi),q4_value(byte_at(qw4,1u),is_hi),q4_value(byte_at(qw4,2u),is_hi),q4_value(byte_at(qw4,3u),is_hi));
            vec4 q5=vec4(q4_value(byte_at(qw5,0u),is_hi),q4_value(byte_at(qw5,1u),is_hi),q4_value(byte_at(qw5,2u),is_hi),q4_value(byte_at(qw5,3u),is_hi));
            vec4 q6=vec4(q4_value(byte_at(qw6,0u),is_hi),q4_value(byte_at(qw6,1u),is_hi),q4_value(byte_at(qw6,2u),is_hi),q4_value(byte_at(qw6,3u),is_hi));
            vec4 q7=vec4(q4_value(byte_at(qw7,0u),is_hi),q4_value(byte_at(qw7,1u),is_hi),q4_value(byte_at(qw7,2u),is_hi),q4_value(byte_at(qw7,3u),is_hi));

            vec4 x0=vec4(x[xb+0u],x[xb+1u],x[xb+2u],x[xb+3u]);
            vec4 x1=vec4(x[xb+4u],x[xb+5u],x[xb+6u],x[xb+7u]);
            vec4 x2=vec4(x[xb+8u],x[xb+9u],x[xb+10u],x[xb+11u]);
            vec4 x3=vec4(x[xb+12u],x[xb+13u],x[xb+14u],x[xb+15u]);
            vec4 x4=vec4(x[xb+16u],x[xb+17u],x[xb+18u],x[xb+19u]);
            vec4 x5=vec4(x[xb+20u],x[xb+21u],x[xb+22u],x[xb+23u]);
            vec4 x6=vec4(x[xb+24u],x[xb+25u],x[xb+26u],x[xb+27u]);
            vec4 x7=vec4(x[xb+28u],x[xb+29u],x[xb+30u],x[xb+31u]);

            float sum_qx = dot(q0,x0)+dot(q1,x1)+dot(q2,x2)+dot(q3,x3)+dot(q4,x4)+dot(q5,x5)+dot(q6,x6)+dot(q7,x7);
            float sum_x = dot(x0,vec4(1))+dot(x1,vec4(1))+dot(x2,vec4(1))+dot(x3,vec4(1))+
                          dot(x4,vec4(1))+dot(x5,vec4(1))+dot(x6,vec4(1))+dot(x7,vec4(1));
            acc += d * float(sm.x) * sum_qx - dmin * float(sm.y) * sum_x;
        }
    }

    reduce_buf[tid] = acc;
    barrier();
    uint row_base = local_row * THREADS_PER_ROW;
    if (local_elem < 4u) { reduce_buf[row_base+local_elem] += reduce_buf[row_base+local_elem+4u]; } barrier();
    if (local_elem < 2u) { reduce_buf[row_base+local_elem] += reduce_buf[row_base+local_elem+2u]; } barrier();
    if (local_elem < 1u) { reduce_buf[row_base+local_elem] += reduce_buf[row_base+local_elem+1u]; } barrier();

    if (local_elem == 0u && global_row < rows)
        out_buf[out_offset + token * rows + global_row] = reduce_buf[row_base];
}
