// Sigmoid gate: out[i] *= sigmoid(gate[head*2*hs + hs + d])
// Dispatch: (ceil(q_dim/256), 1, 1)
#version 450

layout(local_size_x = 256) in;

layout(std430, set=0, binding=0) buffer Out  { float out_buf[]; };
layout(std430, set=0, binding=1) readonly buffer Gate { float gate[]; };

layout(push_constant) uniform PC { uint p0, p1, p2, p3, p4, p5, p6, p7; };

void main() {
    uint gid = gl_WorkGroupID.x * 256u + gl_LocalInvocationID.x;
    uint q_dim = p0;
    uint hs = p1;
    if (gid >= q_dim) return;
    uint head = gid / hs;
    uint d = gid % hs;
    uint gate_idx = head * 2u * hs + hs + d;
    float g = gate[gate_idx];
    out_buf[gid] *= 1.0 / (1.0 + exp(-g));
}
